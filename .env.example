# ============================================================
# Supre Robot — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Discord application ---
# Bot token (Developer Application > Bot > Reset Token)
DISCORD_TOKEN=
# OAuth2 application credentials (Developer Application > General Information)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: restrict slash-command registration to one guild during development
DISCORD_GUILD_ID=

# --- Public URL ---
# Public base URL of the API/dashboard (used for OAuth redirects)
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgres://supre:supre@localhost:5432/supre_robot

# --- Cache (optional) ---
# When unset, an in-memory cache is used (single instance only).
REDIS_URL=redis://localhost:6379

# --- Security ---
# Random secret, >= 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-hex-chars
# Optional: static API key (>= 16 chars) for trusted server-to-server clients
ADMIN_API_KEY=

# --- API server ---
API_HOST=0.0.0.0
API_PORT=3000
# Requests per minute per IP for the public API
REQUEST_RATE_LIMIT_PER_MINUTE=300

# --- Logging ---
LOG_LEVEL=info
# Days to retain bot audit logs in the database
LOG_RETENTION_DAYS=30

# --- Database lifecycle ---
# Run additive migrations automatically on startup
DATABASE_AUTO_MIGRATE=true

# --- Runtime ---
NODE_ENV=development
# Set to true to run ONLY the API/dashboard (no Discord gateway login,
# no command registration). Useful for debugging the web surface.
API_ONLY=false
